# Optional. Copy to .env (cp .env.example .env) to override the defaults in docker-compose.yml.
# Use a long random value in any real deployment, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-of-32-chars-or-more
TOKEN_TTL_HOURS=12
# Number of demo work items created by the seed script
SEED_ITEMS=5000
